# Local development only. Change these values outside a disposable local setup.
NODE_ENV=development
PORT=3000
# Total fresh booking attempts, including the first; valid range 1–10.
BOOKING_MAX_ATTEMPTS=4
# Per-instance capacity; runtime pool size is 10. Waiting bookings hold no DB connection.
BOOKING_MAX_CONCURRENT=8
BOOKING_MAX_PENDING=128
# Total booking budget includes admission, database work, and retry backoff.
# PostgreSQL has a separate fixed 5-second transaction limit; apply npm run db:configure.
BOOKING_TIMEOUT_MS=5000
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=local_scheduler_password
POSTGRES_DB=service_scheduler
POSTGRES_PORT=55432
# Keep credentials/database/port aligned with the POSTGRES_* values above.
DATABASE_URL=postgresql://scheduler:local_scheduler_password@localhost:55432/service_scheduler?schema=public
# Dedicated test server only. Each integration run creates and drops its own database.
TEST_DATABASE_URL=postgresql://scheduler_test:local_scheduler_test_password@127.0.0.1:55433/service_scheduler_test
