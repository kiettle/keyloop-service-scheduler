{
  "name": "keyloop-service-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Keyloop Scenario A backend — database and domain foundation",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch --require ts-node/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/environment.spec.ts",
    "test:http": "vitest run test/health.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:check": "node scripts/check-database.cjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "16.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.15.3",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "eslint": "10.5.0",
    "prettier": "3.6.2",
    "prisma": "7.10.1",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  }
}
